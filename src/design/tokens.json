{
  "$description": "Muse Studio design tokens (W3C Design Tokens Community Group format). Source of truth: edit here, then run `npm run tokens` to regenerate src/design/tokens.css. Direction: calm AI studio (light canvas, soft glow behind the primary action, pill shapes, tonal buttons) inspired by Google's AI product language, with an original violet-to-blue brand.",
  "color": {
    "brand": {
      "violet": { "$type": "color", "$value": "#7C5CFF" },
      "blue": { "$type": "color", "$value": "#3D8BFF" },
      "gradient": { "$type": "gradient", "$value": "linear-gradient(135deg, #7C5CFF 0%, #3D8BFF 100%)" }
    },
    "status": {
      "success": { "$type": "color", "$value": "#1E9E6A" },
      "warning": { "$type": "color", "$value": "#C98A00" },
      "danger": { "$type": "color", "$value": "#D93F3F" }
    }
  },
  "font": {
    "family": {
      "sans": { "$type": "fontFamily", "$value": "'Figtree', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif" }
    },
    "size": {
      "display": { "$type": "dimension", "$value": "44px" },
      "headline": { "$type": "dimension", "$value": "28px" },
      "title": { "$type": "dimension", "$value": "20px" },
      "body": { "$type": "dimension", "$value": "15px" },
      "label": { "$type": "dimension", "$value": "13px" },
      "caption": { "$type": "dimension", "$value": "12px" }
    },
    "weight": {
      "display": { "$type": "fontWeight", "$value": 400 },
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 }
    }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "8px" },
    "md": { "$type": "dimension", "$value": "12px" },
    "lg": { "$type": "dimension", "$value": "20px" },
    "xl": { "$type": "dimension", "$value": "28px" },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "24px" },
    "6": { "$type": "dimension", "$value": "32px" },
    "7": { "$type": "dimension", "$value": "48px" }
  },
  "layout": {
    "nav-h": { "$type": "dimension", "$value": "56px" },
    "sidebar-w": { "$type": "dimension", "$value": "264px" },
    "sidebar-w-collapsed": { "$type": "dimension", "$value": "64px" },
    "content-max": { "$type": "dimension", "$value": "1200px" }
  },
  "theme": {
    "light": {
      "bg": { "$type": "color", "$value": "#F8F9FC" },
      "bg-secondary": { "$type": "color", "$value": "#FFFFFF" },
      "bg-tertiary": { "$type": "color", "$value": "#EEF0F6" },
      "surface": { "$type": "color", "$value": "#FFFFFF" },
      "surface-hover": { "$type": "color", "$value": "#F1F3F8" },
      "border": { "$type": "color", "$value": "rgba(27,27,31,0.10)" },
      "border-subtle": { "$type": "color", "$value": "rgba(27,27,31,0.06)" },
      "text-primary": { "$type": "color", "$value": "#1B1B1F" },
      "text-secondary": { "$type": "color", "$value": "#5D5E66" },
      "text-tertiary": { "$type": "color", "$value": "#9A9BA3" },
      "accent": { "$type": "color", "$value": "#5B4BEF" },
      "accent-hover": { "$type": "color", "$value": "#4A3BDB" },
      "accent-light": { "$type": "color", "$value": "rgba(91,75,239,0.08)" },
      "on-accent": { "$type": "color", "$value": "#FFFFFF" },
      "tonal": { "$type": "color", "$value": "#E7E4FF" },
      "tonal-hover": { "$type": "color", "$value": "#DCD7FF" },
      "on-tonal": { "$type": "color", "$value": "#221A66" },
      "nav-active": { "$type": "color", "$value": "#E9E7FA" },
      "toast-bg": { "$type": "color", "$value": "#2B2B30" },
      "toast-text": { "$type": "color", "$value": "#F2F2F5" },
      "focus-ring": { "$type": "color", "$value": "rgba(91,75,239,0.22)" },
      "glow": { "$type": "gradient", "$value": "radial-gradient(60% 50% at 50% 45%, rgba(124,92,255,0.16) 0%, rgba(61,139,255,0.12) 40%, rgba(248,249,252,0) 75%)" },
      "shadow-sm": { "$type": "shadow", "$value": "0 1px 2px rgba(27,27,31,0.06), 0 1px 3px rgba(27,27,31,0.04)" },
      "shadow-md": { "$type": "shadow", "$value": "0 2px 6px rgba(27,27,31,0.06), 0 8px 24px rgba(27,27,31,0.06)" },
      "shadow-lg": { "$type": "shadow", "$value": "0 12px 40px rgba(27,27,31,0.10), 0 4px 8px rgba(27,27,31,0.04)" }
    },
    "dark": {
      "bg": { "$type": "color", "$value": "#111114" },
      "bg-secondary": { "$type": "color", "$value": "#18181C" },
      "bg-tertiary": { "$type": "color", "$value": "#222228" },
      "surface": { "$type": "color", "$value": "#1A1A1F" },
      "surface-hover": { "$type": "color", "$value": "#24242A" },
      "border": { "$type": "color", "$value": "rgba(255,255,255,0.12)" },
      "border-subtle": { "$type": "color", "$value": "rgba(255,255,255,0.06)" },
      "text-primary": { "$type": "color", "$value": "#E6E6EB" },
      "text-secondary": { "$type": "color", "$value": "#A9AAB3" },
      "text-tertiary": { "$type": "color", "$value": "#6F7079" },
      "accent": { "$type": "color", "$value": "#A9A2FF" },
      "accent-hover": { "$type": "color", "$value": "#C2BDFF" },
      "accent-light": { "$type": "color", "$value": "rgba(169,162,255,0.14)" },
      "on-accent": { "$type": "color", "$value": "#16113F" },
      "tonal": { "$type": "color", "$value": "#2C2858" },
      "tonal-hover": { "$type": "color", "$value": "#37326B" },
      "on-tonal": { "$type": "color", "$value": "#E4E1FF" },
      "nav-active": { "$type": "color", "$value": "#26243F" },
      "toast-bg": { "$type": "color", "$value": "#E6E6EB" },
      "toast-text": { "$type": "color", "$value": "#1B1B1F" },
      "focus-ring": { "$type": "color", "$value": "rgba(169,162,255,0.28)" },
      "glow": { "$type": "gradient", "$value": "radial-gradient(60% 50% at 50% 45%, rgba(124,92,255,0.22) 0%, rgba(61,139,255,0.12) 40%, rgba(17,17,20,0) 75%)" },
      "shadow-sm": { "$type": "shadow", "$value": "0 1px 3px rgba(0,0,0,0.5), 0 1px 2px rgba(0,0,0,0.4)" },
      "shadow-md": { "$type": "shadow", "$value": "0 4px 16px rgba(0,0,0,0.55), 0 2px 4px rgba(0,0,0,0.4)" },
      "shadow-lg": { "$type": "shadow", "$value": "0 12px 40px rgba(0,0,0,0.65), 0 4px 8px rgba(0,0,0,0.4)" }
    }
  }
}
